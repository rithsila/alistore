# Ali Store storefront — environment template.
# Copy to `.env.local` for dev. Production values are set in Vercel, never committed.
# Only NEXT_PUBLIC_* values reach the browser bundle — keep secrets out of that prefix.

# ── Core (required) ──────────────────────────────────────────────────────────

# Medusa backend URL. Dev = Proxmox-hosted Medusa on localhost:9000; prod points
# at the public api.<domain> host. Remember to update the backend's STORE_CORS.
# See https://docs.medusajs.com/learn/configurations/medusa-config#httpstorecors
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable key for the storefront sales channel. THE ONLY HARD-REQUIRED VAR
# (check-env-variables.js fails the build if missing). Client-public by design.
# See https://docs.medusajs.com/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test

# Public URL where the storefront is hosted (dev server runs on :8000).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region, ISO-2 lowercase. Cambodia = "kh". Used to resolve the catalog
# region when the x-vercel-country header is absent.
NEXT_PUBLIC_DEFAULT_REGION=kh

# ── Ali Store specifics ──────────────────────────────────────────────────────

# USD→KHR exchange rate for the client-side currency toggle. NEXT_PUBLIC_ form is
# read first (available during client rendering); USD_KHR_RATE is the server-only
# fallback. Must be a positive number; unset disables the KHR display.
NEXT_PUBLIC_USD_KHR_RATE=4100
USD_KHR_RATE=4100

# Optional Bakong-registered merchant name shown on the KHQR payment card.
# Leave empty to hide it.
NEXT_PUBLIC_KHQR_MERCHANT_NAME=

# ── Next.js / hosting ────────────────────────────────────────────────────────

# Next.js on-demand ISR revalidation secret.
# See https://nextjs.org/docs/app/building-your-application/data-fetching/fetching-caching-and-revalidating#on-demand-revalidation
REVALIDATE_SECRET=supersecret

# Site URL used by next-sitemap to generate sitemap.xml / robots.txt.
# Vercel injects this automatically at build time; set it manually only off-Vercel.
NEXT_PUBLIC_VERCEL_URL=

# Stripe is unused in v1 (payments = Bakong KHQR + COD). Left empty.
NEXT_PUBLIC_STRIPE_KEY=

# For Medusa Cloud users only: S3 hostname + pathname to enable image
# optimization. Ali Store serves images from Cloudflare R2 (hosts are pinned in
# next.config.js), so these stay empty.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
