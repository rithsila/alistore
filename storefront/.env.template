# Ali Store storefront — environment template.
#
# Two consumers, two value sets — do not mix them up:
#   • Local dev  → copy this file to `.env.local` (gitignored) and use the dev
#                  values (localhost backend, dev publishable key).
#   • Vercel     → set the SAME keys in the Vercel project (Settings → Environment
#                  Variables, or `vercel env add`) with the PRODUCTION/UAT values.
#                  Never committed. See docs/vercel-deploy-cli.md for the exact list.
#
# Only NEXT_PUBLIC_* values reach the browser bundle — keep secrets out of that
# prefix. NEXT_PUBLIC_* values are baked in at BUILD time, so changing one in
# Vercel requires a REDEPLOY to take effect.

# ── Core (required) ──────────────────────────────────────────────────────────

# Medusa backend URL. SERVER-ONLY (no NEXT_PUBLIC_ prefix) — never reaches the
# browser. Defaults to http://localhost:9000 if unset, so it MUST be set on Vercel.
#   • Dev    → http://localhost:9000
#   • Vercel → the public backend host. For UAT that is the stable Tailscale
#              Funnel URL, e.g. https://alistore-backend.<tailnet>.ts.net
#              (run `tailscale funnel status` on the backend VM to read it).
# Whatever host you set here must also be in the backend's STORE_CORS / AUTH_CORS,
# because the storefront's /store calls run server-side from Vercel.
# See https://docs.medusajs.com/learn/configurations/medusa-config#httpstorecors
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable key for the storefront sales channel. THE ONLY HARD-REQUIRED VAR
# (check-env-variables.js fails the build if missing — this is why an unset key
# makes the Vercel build exit 1 before `next build` even starts). Client-public
# by design. UAT reuses the SETUP-10 key (same seeded DB). Replace `pk_test` for dev.
# See https://docs.medusajs.com/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test

# Public URL where the storefront is hosted. Used for absolute links (invoice/OG).
#   • Dev    → http://localhost:8000  (starter dev server runs on :8000)
#   • Vercel → the project's stable alias, e.g.
#              https://alistore-sila-c15d6ca9.vercel.app  (or the custom domain).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region, ISO-2 lowercase. Cambodia = "kh". Used to resolve the catalog
# region when the x-vercel-country header is absent. Set "kh" on Vercel.
NEXT_PUBLIC_DEFAULT_REGION=kh

# ── Ali Store specifics ──────────────────────────────────────────────────────

# USD→KHR exchange rate for the client-side currency toggle. NEXT_PUBLIC_ form is
# read first (available during client rendering); USD_KHR_RATE is the server-only
# fallback. Must be a positive number; unset disables the KHR display. Keep BOTH
# in sync with each other AND with the backend's USD_KHR_RATE.
NEXT_PUBLIC_USD_KHR_RATE=4100
USD_KHR_RATE=4100

# Optional Bakong-registered merchant name shown on the KHQR payment card.
# Leave empty to hide it. (COD-only UAT round: leave empty.)
NEXT_PUBLIC_KHQR_MERCHANT_NAME=

# ── Next.js / hosting ────────────────────────────────────────────────────────

# Next.js on-demand ISR revalidation secret. Not read by any current route — the
# storefront does not expose a revalidate handler in v1. Safe to leave as-is /
# omit on Vercel until an on-demand revalidation endpoint is added.
# See https://nextjs.org/docs/app/building-your-application/data-fetching/fetching-caching-and-revalidating#on-demand-revalidation
REVALIDATE_SECRET=supersecret

# Site URL used by next-sitemap. Vercel injects this automatically at build time;
# set it manually only off-Vercel. (No postbuild/sitemap wired in v1 — see the
# "Known caveats" in docs/vercel-deploy.md.)
NEXT_PUBLIC_VERCEL_URL=

# Stripe is unused in v1 (payments = Bakong KHQR + COD). Left empty.
NEXT_PUBLIC_STRIPE_KEY=

# For Medusa Cloud users only: S3 hostname + pathname to enable image
# optimization. Ali Store serves images from Cloudflare R2 (hosts are pinned in
# next.config.js), so these stay empty.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
