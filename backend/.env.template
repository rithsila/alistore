STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000
REDIS_URL=redis://localhost:6379
# Generate fresh, unique values per environment — `openssl rand -base64 48`.
# The backend fails closed if these are unset (see medusa-config.ts).
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DB_NAME=medusa-backend

# Cloudflare R2 file storage (S3-compatible). Product images.
# Public CDN base URL that uploaded images are served from.
S3_FILE_URL=https://img.alistore.com
# R2 ignores region; the S3 client still requires a value.
S3_REGION=auto
# R2 S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
# R2 API token credentials (secrets — never commit real values).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
