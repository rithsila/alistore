STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000
REDIS_URL=redis://localhost:6379
# Generate fresh, unique values per environment — `openssl rand -base64 48`.
# The backend fails closed if these are unset (see medusa-config.ts).
JWT_SECRET=
COOKIE_SECRET=
DATABASE_URL=
DB_NAME=medusa-backend

# Cloudflare R2 file storage (S3-compatible). Product images.
# Public CDN base URL that uploaded images are served from.
S3_FILE_URL=https://img.alistore.com
# R2 ignores region; the S3 client still requires a value.
S3_REGION=auto
# R2 S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
# R2 API token credentials (secrets — never commit real values).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bakong KHQR payment (Individual account). All Bakong traffic routes through
# the in-Cambodia proxy — never call Bakong directly. Secrets — never commit real values.
# BAKONG_PROXY_URL must be https:// on the hard-coded allowlist (see security.md SSRF).
BAKONG_TOKEN=
BAKONG_PROXY_URL=
BAKONG_ACCOUNT=
# Comma-separated allowlist of proxy hosts (SSRF guard). Set at deploy to the
# in-Cambodia proxy host(s). REQUIRED in production (NODE_ENV=production) — the
# backend refuses to boot with BAKONG_PROXY_URL set but this empty. In dev only
# https + non-private-IP is enforced when empty.
BAKONG_PROXY_ALLOWED_HOSTS=
# DEV ONLY — never set in production (ignored when NODE_ENV=production). =1
# lets BAKONG_PROXY_URL target a plain-http LOOPBACK address (127.0.0.0/8,
# ::1, localhost) so the E2E spec (storefront/tests/khqr.spec.ts) can host a
# mock Bakong proxy and simulate the paid flip. Loopback-only — every other
# SSRF rule stays enforced.
BAKONG_PROXY_DEV_ALLOW_LOOPBACK=
# KHQR merchant display fields (tags 59/60) and QR lifetime in minutes.
# Optional — default to "Ali Store" / "Phnom Penh" / 20 when unset.
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=
BAKONG_QR_EXPIRES_MINUTES=

# ABA PayWay (PAYWAY-01/02) — DORMANT in v1. ABA declined the direct merchant
# application (needs a business license), so KHPAY below is the active KHQR rail.
# The module stays in the repo and registers as a payment provider only when BOTH
# PAYWAY_MERCHANT_ID and PAYWAY_API_KEY are set (see medusa-config.ts). Direct
# HTTPS gateway (no proxy); PAYWAY_BASE_URL is SSRF-allowlisted and validated at
# boot. Secrets — never commit real values. Leave unset in v1.
PAYWAY_BASE_URL=
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Payment lifetime in minutes; defaults to 20 (== stock-reservation TTL) when unset.
PAYWAY_EXPIRES_MINUTES=
# Server-to-server pushback (callback) URL PayWay posts payment confirmation to.
PAYWAY_PUSHBACK_URL=
# DEV ONLY — never set in production (ignored when NODE_ENV=production). =1 lets
# PAYWAY_BASE_URL target a plain-http LOOPBACK mock gateway so the E2E spec
# (storefront/tests/payway.spec.ts) can drive the flow. Loopback-only.
PAYWAY_DEV_ALLOW_LOOPBACK=

# KHPAY (KHPAY-01) — ACTIVE KHQR provider. The storefront "Pay with KHQR" flow
# drives /store/payments/khpay/* (ImplementPlan Phase 7 locked decision).
# Registers as a payment provider only when KHPAY_API_KEY is set (see
# medusa-config.ts). Aggregator over the Bakong rail, direct HTTPS;
# KHPAY_BASE_URL is SSRF-allowlisted (khpay.site) and validated at boot.
# KHPAY_API_KEY is a secret — never commit the real value. Get the key at
# https://khpay.site/dashboard/settings (configure Settings → Bakong first).
KHPAY_BASE_URL=https://khpay.site/api/v1
KHPAY_API_KEY=
# Payment lifetime in minutes; defaults to 20 (== stock-reservation TTL) when unset.
KHPAY_EXPIRES_MINUTES=
# DEV ONLY — never set in production (ignored when NODE_ENV=production). =1 lets
# KHPAY_BASE_URL target a plain-http LOOPBACK mock gateway so the E2E spec
# (storefront/tests/khpay.spec.ts) can drive the flow. Loopback-only.
KHPAY_DEV_ALLOW_LOOPBACK=

# Telegram Bot API (order alerts to a private chat). Secrets — never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Facebook OAuth (optional customer login). Scopes: email, public_profile only.
# Secrets — never commit real values. FB_OAUTH_REDIRECT_URI must exactly match
# the redirect URI registered in the Facebook app and end in
# /store/auth/facebook/callback — use the STOREFRONT origin (the storefront
# proxies /store/auth/* to the backend) so the OAuth state/session cookies stay
# same-origin (defaults to the localhost dev callback if unset).
FB_APP_ID=
FB_APP_SECRET=
FB_OAUTH_REDIRECT_URI=
# DEV ONLY — never set in production (ignored when NODE_ENV=production). Points
# the Facebook provider's server-side Graph calls (token exchange + profile) at
# a plain-http LOOPBACK mock Graph API so the E2E spec
# (storefront/tests/fb-login.spec.ts) can drive the full login chain without a
# real Facebook app. Loopback-only — any other host is ignored.
FB_GRAPH_DEV_BASE_URL=

# Google OAuth (optional customer login). Scopes: email profile openid only.
# Secrets — never commit real values. GOOGLE_OAUTH_REDIRECT_URI must exactly
# match the redirect URI registered in the Google OAuth client and end in
# /store/auth/google/callback (defaults to the localhost dev callback if unset).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# DEV ONLY — never set in production (ignored when NODE_ENV=production). Points
# the Google callback's server-side code exchange at a plain-http LOOPBACK mock
# token endpoint so the E2E spec (storefront/tests/google-login.spec.ts) can
# drive the full login chain without a real Google OAuth client. Loopback-only —
# any other host is ignored.
GOOGLE_TOKEN_DEV_BASE_URL=

# Number of trusted reverse proxies in front of the backend (e.g. 1 for
# Cloudflare). Used to derive the real client IP for rate limiting. 0 = trust
# only the direct socket (X-Forwarded-For is ignored, so it can't be spoofed to
# evade limits). Set this to match the deploy topology.
TRUSTED_PROXY_COUNT=0

# Business config (set per environment). USD→KHR exchange rate; KHR rounds to whole riel.
# LOW_STOCK_THRESHOLD defaults to 5 in code (src/lib/settings.ts) when unset.
USD_KHR_RATE=
LOW_STOCK_THRESHOLD=
DELIVERY_FEE=
FREE_DELIVERY_THRESHOLD=

# Invoice (BACKEND-06). VAT is "VAT-ready" but OFF by default in v1 — leave
# INVOICE_VAT_ENABLED unset/false so the VAT line and TIN are hidden. When
# enabling: set INVOICE_VAT_ENABLED=true and supply INVOICE_TIN. VAT_RATE
# defaults to 0.10 (Cambodia 10% standard); INVOICE_BUSINESS_NAME defaults to
# "Ali Store" in code (src/lib/invoice-template.ts) when unset.
INVOICE_VAT_ENABLED=
VAT_RATE=
INVOICE_TIN=
INVOICE_BUSINESS_NAME=

# DEV ONLY — publishable key consumed by the dev helper script
# src/scripts/dev-create-test-cart.ts to build a throwaway test cart. Not read
# by the running server; leave unset in production.
TEST_PUBLISHABLE_KEY=
