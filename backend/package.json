{
  "name": "ali-store-backend",
  "version": "0.0.1",
  "description": "Ali Store — Medusa v2 backend.",
  "author": "Ali Store",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@agilo/medusa-analytics-plugin": "1.4.0",
    "@medusajs/admin-sdk": "2.15.3",
    "@medusajs/admin-shared": "2.15.3",
    "@medusajs/caching": "2.15.3",
    "@medusajs/cli": "2.15.3",
    "@medusajs/dashboard": "2.15.3",
    "@medusajs/draft-order": "2.15.3",
    "@medusajs/framework": "2.15.3",
    "@medusajs/medusa": "2.15.3",
    "@medusajs/ui": "4.1.13",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.3",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.15.3",
    "@swc/core": "1.15.40",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.41",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "yalc": "1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.11.1",
  "overrides": {
    "ajv": "8.20.0"
  }
}
